{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "focus_risk_id", "harm_type", "final_state", "risk_object",
    "boundary_or_requirement", "risk_node_ids", "plan_node_ids",
    "correction_node_ids", "risk_score", "reason"
  ],
  "properties": {
    "focus_risk_id": {"type": "string"},
    "harm_type": {
      "enum": [
        "hallucination", "privacy", "boundary_collapse",
        "guardrail_erosion", "none"
      ]
    },
    "final_state": {
      "enum": ["active", "corrected", "reopened", "considered_only", "unclear"]
    },
    "risk_object": {"type": "string"},
    "boundary_or_requirement": {"type": "string"},
    "risk_node_ids": {
      "type": "array", "items": {"type": "string"}
    },
    "plan_node_ids": {
      "type": "array", "items": {"type": "string"}
    },
    "correction_node_ids": {
      "type": "array", "items": {"type": "string"}
    },
    "risk_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "reason": {"type": "string"}
  }
}
