Bootstrap: docker
From: python:3.11

%post
    pip install --no-cache-dir urllib3 requests pytz python-dateutil "huggingface-hub<0.30.0" openai sentence-transformers Pillow
    export SENTENCE_TRANSFORMERS_HOME=/opt/sentence_transformers
    python3 -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"

%environment
    export PYTHONUNBUFFERED=1
    export SENTENCE_TRANSFORMERS_HOME=/opt/sentence_transformers
